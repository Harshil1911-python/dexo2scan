{
  "name": "dexo2scan",
  "version": "1.0.0",
  "description": "Mobile bill/invoice scanner using Capacitor, ML Kit OCR, local parsing, IndexedDB",
  "main": "index.js",
  "scripts": {
    "build": "echo 'Static web assets - no build step needed' && mkdir -p www && cp -r src/* www/ || true",
    "start": "npx serve www",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:add:android": "npx cap add android"
  },
  "keywords": [
    "capacitor",
    "ocr",
    "mlkit",
    "invoice",
    "scanner"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/camera": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@jcesarmobile/capacitor-ocr": "^0.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "typescript": "^5.0.0"
  }
}
